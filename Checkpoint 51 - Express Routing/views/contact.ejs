<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | NovaTech Solutions</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include("partials/navbar") %>

  <main class="container">
    <h1>Contact Us</h1>
    <p class="subtitle">Reach out to our team during working hours (Monday – Friday, 09:00 – 17:00).</p>

    <div class="contact-wrapper">
      <form class="contact-form" onsubmit="event.preventDefault(); alert('Thank you! Your message has been received.');">
        <label for="name">Full Name</label>
        <input type="text" id="name" placeholder="Golden-Joe Osegbe" required />

        <label for="email">Email Address</label>
        <input type="email" id="email" placeholder="you@example.com" required />

        <label for="message">Message</label>
        <textarea id="message" rows="4" placeholder="How can we help you?" required></textarea>

        <button type="submit" class="btn">Send Message</button>
      </form>

      <aside class="card">
        <h3>Office Information</h3>
        <p><strong>Location:</strong> Lagos, Nigeria</p>
        <p><strong>Email:</strong> support@novatech.example.com</p>
        <p><strong>Hours:</strong> Mon – Fri, 09:00 – 17:00</p>
      </aside>
    </div>
  </main>
</body>
</html>